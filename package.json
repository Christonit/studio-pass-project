{
  "name": "studiopass",
  "version": "0.5.0",
  "private": true,
  "description": "StudioPass — credit-based class booking for independent fitness & yoga studios (CIS 9590, Team 8)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "reset": "node scripts/reset.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:seed-sql": "node scripts/export-seed-sql.js",
    "db:migrate": "node scripts/db-apply.js migrate",
