    "db:reset": "node scripts/db-apply.js reset",
    "db:down": "node scripts/db-apply.js down"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "agentation": "^3.1.2",
    "postgres": "^3.4.9"
  }
}
